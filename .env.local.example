# ni la préfixer par NEXT_PUBLIC_. Ne la commitez pas. Doit aussi être ajoutée dans
# Vercel -> Project Settings -> Environment Variables pour fonctionner en production.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
